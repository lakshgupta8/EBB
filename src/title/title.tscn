[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://src/title/title.gd" id="1_title"]
[ext_resource type="PackedScene" path="res://src/ui/codex_ui.tscn" id="3_codex"]
[ext_resource type="PackedScene" path="res://src/ui/settings_ui.tscn" id="4_settings"]
[ext_resource type="PackedScene" path="res://src/ui/log_ui.tscn" id="5_log"]

[node name="Title" type="Node2D"]
script = ExtResource("1_title")

[node name="Layer" type="CanvasLayer" parent="."]

[node name="CodexUI" parent="." instance=ExtResource("3_codex")]

[node name="SettingsUI" parent="." instance=ExtResource("4_settings")]

[node name="LogUI" parent="." instance=ExtResource("5_log")]
