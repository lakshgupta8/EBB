extends Node
## Sound: a pool of players for effects, one looping ambient bed, occasional gulls.
## All clips are generated by tools/gen_audio.py: effects as WAV, music and beds as Ogg.

const DIR := "res://assets/audio/"
const POOL_SIZE := 14
## Clips that belong to the menus play on the Interface bus, dry (STYLE.md 23.5).
const INTERFACE := ["ui", "buy", "page", "gift"]
## The reverb of each place on the Space bus (STYLE.md 23.6): room size, damping, wet, pre-delay ms.
const SPACES := {
	"rock": [0.25, 0.6, 0.06, 10.0],
	"flats": [0.30, 0.5, 0.05, 20.0],
	"harbour": [0.45, 0.4, 0.10, 60.0],
	"reef": [0.55, 0.7, 0.12, 30.0],
	"streets": [0.65, 0.35, 0.14, 40.0],
	"hall": [0.90, 0.3, 0.22, 50.0],
}

var _streams: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _ambient: AudioStreamPlayer
var _layer: AudioStreamPlayer   # a second bed under the sea: the place itself (M8)
var _music: AudioStreamPlayer
var music_name: String = ""
var _gull_t: float = 0.0
var gulls_enabled: bool = false
var _last_play: Dictionary = {}  # name -> msec, to avoid machine-gunning the same clip
## Sound rolls on its own stream. It is asked for things once a frame, and a night has to
## be the same night whatever the frame rate: only the game may draw from the global one.
var _rng := RandomNumberGenerator.new()
var space_name: String = ""
var _duck_tw: Tween
## Every clip asked for this session, by name (the base name, before a variant is picked),
## for the audio audit (audio Stage 01: `--audio-log=` on the bot). Counting draws nothing.
var asked: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "Effects"
		add_child(p)
		_pool.append(p)
	_ambient = AudioStreamPlayer.new()
	_ambient.volume_db = -9.0
	_ambient.bus = "Ambience"
	add_child(_ambient)
	_layer = AudioStreamPlayer.new()
	_layer.volume_db = -16.0
	_layer.bus = "Ambience"
	add_child(_layer)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)


var _variants: Dictionary = {}  # base name -> count of name_0, name_1, ...


## "hit" resolves to a random one of hit_0, hit_1... when variants exist.
func _resolve(name: String) -> String:
	if not _variants.has(name):
		var count := 0
		while _path("%s_%d" % [name, count]) != "":
			count += 1
		_variants[name] = count
	var count: int = _variants[name]
	if count == 0:
		return name
	return "%s_%d" % [name, _rng.randi() % count]


## A clip's file, WAV or Ogg; "" when there is none.
static func _path(name: String) -> String:
	for ext in [".wav", ".ogg"]:
		if ResourceLoader.exists(DIR + name + ext):
			return DIR + name + ext
	return ""


func _stream(name: String) -> AudioStream:
	name = _resolve(name)
	if _streams.has(name):
		return _streams[name]
	var path := _path(name)
	if path == "":
		push_warning("no audio clip: " + name)
		_streams[name] = null
		return null
	var s := load(path)
	_streams[name] = s
	return s


## Play a clip with optional random pitch spread (0.15 = +-15%) and volume offset.
func play(name: String, pitch_var: float = 0.0, db: float = 0.0, min_gap_ms: int = 35) -> void:
	asked[name] = int(asked.get(name, 0)) + 1
	var now := Time.get_ticks_msec()
	if now - int(_last_play.get(name, -1000)) < min_gap_ms:
		return
	_last_play[name] = now
	var s := _stream(name)
	if s == null:
		return
	var bus := "Interface" if name in INTERFACE else "Effects"
	for p in _pool:
		if not p.playing:
			p.bus = bus
			p.stream = s
			p.pitch_scale = 1.0 + _rng.randf_range(-pitch_var, pitch_var)
			p.volume_db = db
			p.play()
			return
	# All busy: steal the first.
	var p := _pool[0]
	p.bus = bus
	p.stream = s
	p.pitch_scale = 1.0 + _rng.randf_range(-pitch_var, pitch_var)
	p.volume_db = db
	p.play()


func ambient(name: String, db: float = -9.0) -> void:
	asked[name] = int(asked.get(name, 0)) + 1
	var s := _stream(name)
	if s == null:
		return
	_loop(s)
	if _ambient.stream == s and _ambient.playing:
		return
	_ambient.stream = s
	_ambient.volume_db = db
	_ambient.play()


func stop_ambient() -> void:
	_ambient.stop()


## The second ambience bed: what this place sounds like under the sea (amb_flats,
## amb_harbour, amb_streets, amb_hall). "" stops it.
func layer(name: String, db: float = -16.0) -> void:
	if name == "":
		_layer.stop()
		return
	asked[name] = int(asked.get(name, 0)) + 1
	var s := _stream(name)
	if s == null:
		return
	_loop(s)
	if _layer.stream == s and _layer.playing:
		_layer.volume_db = db
		return
	_layer.stream = s
	_layer.volume_db = db
	_layer.play()


func stop_layer() -> void:
	_layer.stop()


static func _loop(s: AudioStream) -> void:
	if s is AudioStreamOggVorbis:
		s.loop = true
	elif s is AudioStreamWAV and s.loop_mode == AudioStreamWAV.LOOP_DISABLED:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = s.data.size() / 2  # 16-bit mono frames


## The place's reverb on the Space bus, eased over a second and a half.
func space(name: String) -> void:
	if name == space_name or not SPACES.has(name):
		return
	space_name = name
	var bus := AudioServer.get_bus_index("Space")
	if bus == -1:
		return
	var r := AudioServer.get_bus_effect(bus, 0) as AudioEffectReverb
	var v: Array = SPACES[name]
	r.room_size = v[0]
	r.damping = v[1]
	r.predelay_msec = v[3]
	var tw := create_tween()
	tw.tween_property(r, "wet", v[2], 1.5)


## The music steps back under a big moment (a boss's roar, a phase, a hit on Tam), then
## returns over half a second (STYLE.md 23.5).
func duck(db: float = -6.0, hold: float = 0.15) -> void:
	var bus := AudioServer.get_bus_index("Music")
	if bus == -1:
		return
	var amp := AudioServer.get_bus_effect(bus, 0) as AudioEffectAmplify
	if _duck_tw:
		_duck_tw.kill()
	_duck_tw = create_tween()
	_duck_tw.tween_property(amp, "volume_db", db, 0.05)
	_duck_tw.tween_interval(hold)
	_duck_tw.tween_property(amp, "volume_db", 0.0, 0.5)


## A looping track on the Music bus; the old one fades out under the new one.
func music(name: String, db: float = -8.0) -> void:
	asked[name] = int(asked.get(name, 0)) + 1
	if name == music_name and _music.playing:
		return
	var s := _stream(name)
	if s == null:
		return
	_loop(s)
	music_name = name
	if _music.playing:
		var old := _music
		_music = AudioStreamPlayer.new()
		_music.bus = "Music"
		add_child(_music)
		var tw := old.create_tween()
		tw.tween_property(old, "volume_db", -40.0, 1.5)
		tw.tween_callback(old.queue_free)
	_music.stream = s
	_music.volume_db = db - 12.0
	_music.play()
	var up := _music.create_tween()
	up.tween_property(_music, "volume_db", db, 1.5)


func stop_music() -> void:
	music_name = ""
	if _music.playing:
		var tw := _music.create_tween()
		tw.tween_property(_music, "volume_db", -40.0, 1.5)
		tw.tween_callback(_music.stop)


func _process(delta: float) -> void:
	if not gulls_enabled or get_tree().paused:
		return
	_gull_t -= delta
	if _gull_t <= 0.0:
		_gull_t = _rng.randf_range(18.0, 45.0)
		play("gull_%d" % (_rng.randi() % 3), 0.1, -16.0)
