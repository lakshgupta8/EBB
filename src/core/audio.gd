extends Node
## Sound: a pool of players for effects, one looping ambient bed, occasional gulls.
## All clips are generated by tools/gen_audio.py.

const DIR := "res://assets/audio/"
const POOL_SIZE := 14

var _streams: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _ambient: AudioStreamPlayer
var _layer: AudioStreamPlayer   # a second bed under the sea: the place itself (M8)
var _music: AudioStreamPlayer
var music_name: String = ""
var _gull_t: float = 0.0
var gulls_enabled: bool = false
var _last_play: Dictionary = {}  # name -> msec, to avoid machine-gunning the same clip
## Sound rolls on its own stream. It is asked for things once a frame, and a night has to
## be the same night whatever the frame rate: only the game may draw from the global one.
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	_ambient = AudioStreamPlayer.new()
	_ambient.volume_db = -9.0
	_ambient.bus = "SFX"
	add_child(_ambient)
	_layer = AudioStreamPlayer.new()
	_layer.volume_db = -16.0
	_layer.bus = "SFX"
	add_child(_layer)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)


var _variants: Dictionary = {}  # base name -> count of name_0, name_1, ...


## "hit" resolves to a random one of hit_0, hit_1... when variants exist.
func _resolve(name: String) -> String:
	if not _variants.has(name):
		var count := 0
		while ResourceLoader.exists(DIR + "%s_%d.wav" % [name, count]):
			count += 1
		_variants[name] = count
	var count: int = _variants[name]
	if count == 0:
		return name
	return "%s_%d" % [name, _rng.randi() % count]


func _stream(name: String) -> AudioStream:
	name = _resolve(name)
	if _streams.has(name):
		return _streams[name]
	var path := DIR + name + ".wav"
	if not ResourceLoader.exists(path):
		push_warning("no audio clip: " + name)
		_streams[name] = null
		return null
	var s := load(path)
	_streams[name] = s
	return s


## Play a clip with optional random pitch spread (0.15 = +-15%) and volume offset.
func play(name: String, pitch_var: float = 0.0, db: float = 0.0, min_gap_ms: int = 35) -> void:
	var now := Time.get_ticks_msec()
	if now - int(_last_play.get(name, -1000)) < min_gap_ms:
		return
	_last_play[name] = now
	var s := _stream(name)
	if s == null:
		return
	for p in _pool:
		if not p.playing:
			p.stream = s
			p.pitch_scale = 1.0 + _rng.randf_range(-pitch_var, pitch_var)
			p.volume_db = db
			p.play()
			return
	# All busy: steal the first.
	var p := _pool[0]
	p.stream = s
	p.pitch_scale = 1.0 + _rng.randf_range(-pitch_var, pitch_var)
	p.volume_db = db
	p.play()


func ambient(name: String, db: float = -9.0) -> void:
	var s := _stream(name)
	if s == null:
		return
	if s is AudioStreamWAV and s.loop_mode == AudioStreamWAV.LOOP_DISABLED:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = s.data.size() / 2  # 16-bit mono frames
	if _ambient.stream == s and _ambient.playing:
		return
	_ambient.stream = s
	_ambient.volume_db = db
	_ambient.play()


func stop_ambient() -> void:
	_ambient.stop()


## The second ambience bed: what this place sounds like under the sea (amb_flats,
## amb_harbour, amb_streets, amb_hall). "" stops it.
func layer(name: String, db: float = -16.0) -> void:
	if name == "":
		_layer.stop()
		return
	var s := _stream(name)
	if s == null:
		return
	_loop(s)
	if _layer.stream == s and _layer.playing:
		_layer.volume_db = db
		return
	_layer.stream = s
	_layer.volume_db = db
	_layer.play()


func stop_layer() -> void:
	_layer.stop()


static func _loop(s: AudioStream) -> void:
	if s is AudioStreamWAV and s.loop_mode == AudioStreamWAV.LOOP_DISABLED:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = s.data.size() / 2


## A looping track on the Music bus; the old one fades out under the new one.
func music(name: String, db: float = -8.0) -> void:
	if name == music_name and _music.playing:
		return
	var s := _stream(name)
	if s == null:
		return
	_loop(s)
	music_name = name
	if _music.playing:
		var old := _music
		_music = AudioStreamPlayer.new()
		_music.bus = "Music"
		add_child(_music)
		var tw := old.create_tween()
		tw.tween_property(old, "volume_db", -40.0, 1.5)
		tw.tween_callback(old.queue_free)
	_music.stream = s
	_music.volume_db = db - 12.0
	_music.play()
	var up := _music.create_tween()
	up.tween_property(_music, "volume_db", db, 1.5)


func stop_music() -> void:
	music_name = ""
	if _music.playing:
		var tw := _music.create_tween()
		tw.tween_property(_music, "volume_db", -40.0, 1.5)
		tw.tween_callback(_music.stop)


func _process(delta: float) -> void:
	if not gulls_enabled or get_tree().paused:
		return
	_gull_t -= delta
	if _gull_t <= 0.0:
		_gull_t = _rng.randf_range(18.0, 45.0)
		play("gull_%d" % (_rng.randi() % 3), 0.1, -16.0)
