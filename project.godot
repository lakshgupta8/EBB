; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the build here is code-first, so it is maintained by hand.

config_version=5

[application]

config/name="EBB"
config/description="Top-down action roguelite. Keep the tide."
run/main_scene="res://src/title/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
Game="*res://src/core/game.gd"
Settings="*res://src/core/settings.gd"
Juice="*res://src/core/juice.gd"
SaveManager="*res://src/core/save_manager.gd"
FX="*res://src/fx/fx.gd"
Audio="*res://src/core/audio.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://assets/fonts/ebb.fnt"
theme/default_font_size=8

[input]

move_left={
